file(MAKE_DIRECTORY "${WORK_ROOT}")
string(RANDOM LENGTH 12 ALPHABET "abcdefghijklmnopqrstuvwxyz0123456789" run)
set(root "${WORK_ROOT}/${run}")
file(MAKE_DIRECTORY "${root}/tmp")
if(CMAKE_HOST_WIN32)
  set(separator ";")
  set(first_thread)
else()
  set(separator ":")
  if(CMAKE_HOST_APPLE)
    set(first_thread -XstartOnFirstThread)
  endif()
endif()
execute_process(COMMAND "${GENERATOR}" "${root}" RESULT_VARIABLE status TIMEOUT 30)
if(NOT status STREQUAL "0")
  message(FATAL_ERROR "Export generator failed: ${status}")
endif()
foreach(case IN ITEMS blank scene_inspector render_settings debug_console all_widgets edge empty window_chrome)
  set(project "${root}/${case}/java")
  set(extra_sources)
  if(case STREQUAL "edge")
    set(extra_class ModelInteraction)
    set(expected "Java model selection, templates, charts, animations and images verified")
  elseif(case STREQUAL "window_chrome")
    set(extra_class WindowChromeCheck)
    set(expected "Window chrome interactions verified")
  else()
    unset(extra_class)
  endif()
  if(extra_class)
    set(extra_sources "${extra_class}.java")
  endif()
  execute_process(COMMAND "${JAVAC}" --release 17 -encoding UTF-8 -Xlint:all -Werror
    -cp "${BINDINGS}/*" -d out Main.java StudioUI.java ${extra_sources}
    WORKING_DIRECTORY "${project}" TIMEOUT 25 RESULT_VARIABLE status)
  if(NOT status STREQUAL "0")
    message(FATAL_ERROR "${case}: javac failed (${status})")
  endif()
  execute_process(COMMAND "${JAVA}" ${first_thread} --enable-native-access=ALL-UNNAMED
    "-Djava.io.tmpdir=${root}/tmp" -cp "out${separator}.${separator}${BINDINGS}/*" Main --smoke-test
    WORKING_DIRECTORY "${project}" TIMEOUT 25 RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors)
  if(NOT status STREQUAL "0" OR NOT output MATCHES "rendered three frames")
    message(FATAL_ERROR "${case}: ${status}\n${output}\n${errors}")
  endif()
  if(extra_sources)
    execute_process(COMMAND "${JAVA}" --enable-native-access=ALL-UNNAMED
      "-Djava.io.tmpdir=${root}/tmp" -cp "out${separator}.${separator}${BINDINGS}/*" ${extra_class}
      WORKING_DIRECTORY "${project}" TIMEOUT 25 RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors)
    if(NOT status STREQUAL "0" OR NOT output MATCHES "${expected}")
      message(FATAL_ERROR "Java ${case} interactions failed (${status}):\n${output}\n${errors}")
    endif()
  endif()
endforeach()
message(STATUS "Eight generated Java projects compiled and ran GLFW/OpenGL with imgui-java")
