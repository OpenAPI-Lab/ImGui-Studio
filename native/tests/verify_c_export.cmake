file(MAKE_DIRECTORY "${WORK_ROOT}/src")
set(source "${WORK_ROOT}/src")
execute_process(COMMAND "${GENERATOR}" "${source}" RESULT_VARIABLE status TIMEOUT 30)
if(NOT status STREQUAL "0")
  message(FATAL_ERROR "Export generator failed: ${status}")
endif()
file(WRITE "${source}/CMakeLists.txt" [=[
cmake_minimum_required(VERSION 3.16)
project(VerifyStudioC LANGUAGES C CXX)
enable_testing()
add_subdirectory(edge/c_app)
function(require_strict_c target)
  set_target_properties(${target} PROPERTIES C_STANDARD 11 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
  if(MSVC)
    target_compile_options(${target} PRIVATE /utf-8 /W4 /WX)
  else()
    target_compile_options(${target} PRIVATE -Wall -Wextra -Werror -pedantic)
  endif()
endfunction()
require_strict_c(studio_export_c)
add_executable(studio_c_model_interaction edge/c_app/model_interaction.c)
target_link_libraries(studio_c_model_interaction PRIVATE studio_c_backend)
require_strict_c(studio_c_model_interaction)
add_test(NAME C_ModelInteraction COMMAND studio_c_model_interaction)
add_executable(studio_c_window_chrome_interaction window_chrome/c_app/model_interaction.c)
target_link_libraries(studio_c_window_chrome_interaction PRIVATE studio_c_backend)
require_strict_c(studio_c_window_chrome_interaction)
add_test(NAME C_WindowChromeInteraction COMMAND studio_c_window_chrome_interaction)
foreach(case blank scene_inspector render_settings debug_console all_widgets empty window_chrome)
  add_executable(studio_c_${case} ${case}/c_app/main.c)
  target_link_libraries(studio_c_${case} PRIVATE studio_c_backend)
  require_strict_c(studio_c_${case})
  add_test(NAME C_${case} COMMAND studio_c_${case} --smoke-test)
endforeach()
]=])
set(overrides)
foreach(dep GLFW CIMGUI IMGUI STB)
  if(NOT "${${dep}_SOURCE}" STREQUAL "")
    list(APPEND overrides "-DFETCHCONTENT_SOURCE_DIR_${dep}=${${dep}_SOURCE}")
  endif()
endforeach()
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${source}" -B "${WORK_ROOT}/build" -G "${BUILD_GENERATOR}"
  ${overrides} RESULT_VARIABLE status TIMEOUT 90)
if(NOT status STREQUAL "0")
  message(FATAL_ERROR "C export configure failed: ${status}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${WORK_ROOT}/build" --config Debug --parallel 2 RESULT_VARIABLE status TIMEOUT 160)
if(NOT status STREQUAL "0")
  message(FATAL_ERROR "C export build failed: ${status}")
endif()
execute_process(COMMAND "${CMAKE_CTEST_COMMAND}" --test-dir "${WORK_ROOT}/build" -C Debug --output-on-failure
  RESULT_VARIABLE status TIMEOUT 50)
if(NOT status STREQUAL "0")
  message(FATAL_ERROR "C export runtime failed: ${status}")
endif()
