        },
        {
          "id": "job_progress",
          "type": "circular_progress",
          "label": "Procesado",
          "varName": "processing",
          "x": 174,
          "y": 78,
          "width": 96,
          "useCursorPos": true,
          "props": { "fraction": 0.65, "overlay": "65 %", "progressFillColorOverride": "#55ce95" }
        }
