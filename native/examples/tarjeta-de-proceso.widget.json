{
  "format": "imgui-studio-widget",
  "version": 1,
  "name": "Tarjeta de proceso",
  "node": {
    "id": "process_card",
    "type": "group",
    "label": "Tarjeta de proceso",
    "varName": "process_card",
    "props": {},
    "children": [
      {
        "id": "process_heading",
        "type": "separator_text",
        "label": "Procesamiento",
        "varName": "process_heading",
        "props": {}
      },
      {
        "id": "process_progress",
        "type": "progress_bar",
        "label": "Progreso",
        "varName": "process_progress",
        "width": 210,
        "height": 24,
        "props": { "fraction": 0.65, "overlay": "65 %" }
      },
      {
        "id": "process_pause",
        "type": "checkbox",
        "label": "Pausar",
        "varName": "process_paused",
        "props": { "checked": false }
      }
    ]
  }
}
