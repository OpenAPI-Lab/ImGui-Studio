string(RANDOM LENGTH 12 suffix)
set(directory "${OUTPUT}/projects-${suffix}")
file(MAKE_DIRECTORY "${directory}/packs")
foreach(platform IN ITEMS macOS iOS)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E tar xf "${PACKS}/ImGuiStudio-${platform}-Cpp-${VERSION}.zip"
    WORKING_DIRECTORY "${directory}/packs" RESULT_VARIABLE result TIMEOUT 30)
  if(NOT result STREQUAL "0")
    message(FATAL_ERROR "Cannot extract ${platform} pack: ${result}")
  endif()
endforeach()
execute_process(COMMAND "${GENERATOR}" --apple "${directory}/packs" "${directory}"
  RESULT_VARIABLE result TIMEOUT 30)
if(NOT result STREQUAL "0")
  message(FATAL_ERROR "Apple export generation failed: ${result}")
endif()

if(NOT CMAKE_HOST_APPLE)
  foreach(platform IN ITEMS macos ios)
    execute_process(COMMAND "${CMAKE_COMMAND}" -S "${directory}/${platform}" -B "${directory}/${platform}-build"
      RESULT_VARIABLE result ERROR_VARIABLE error TIMEOUT 30)
    if(result STREQUAL "0" OR NOT error MATCHES "requires a Mac with Xcode")
      message(FATAL_ERROR "Unexpected configure result for ${platform}: ${result}, ${error}")
    endif()
  endforeach()
endif()
message(STATUS "Generated Apple projects: ${directory}")

if(BUILD_APPLE)
  if(NOT CMAKE_HOST_APPLE)
    message(FATAL_ERROR "Building Apple exports requires macOS and Xcode.")
  endif()
  find_program(plutil plutil REQUIRED)
  foreach(platform IN ITEMS macos ios)
    set(options)
    if(platform STREQUAL "ios")
      list(APPEND options -DCMAKE_SYSTEM_NAME=iOS -DCMAKE_OSX_SYSROOT=iphonesimulator)
    endif()
    set(build "${directory}/${platform}-build")
    execute_process(COMMAND "${CMAKE_COMMAND}" -S "${directory}/${platform}" -B "${build}" -G Xcode
      -DCMAKE_XCODE_ATTRIBUTE_CODE_SIGNING_ALLOWED=NO ${options}
      RESULT_VARIABLE result TIMEOUT 180)
    if(NOT result STREQUAL "0")
      message(FATAL_ERROR "${platform} configure failed: ${result}")
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" --build "${build}" --config Debug --target studio_export --parallel 2
      RESULT_VARIABLE result TIMEOUT 150)
    if(NOT result STREQUAL "0")
      message(FATAL_ERROR "${platform} build failed: ${result}")
    endif()
    file(GLOB bundles LIST_DIRECTORIES true "${build}/Debug*/studio_export.app")
    list(LENGTH bundles bundle_count)
    if(NOT bundle_count EQUAL 1)
      message(FATAL_ERROR "Expected one application bundle for ${platform}, found: ${bundles}")
    endif()
    list(GET bundles 0 bundle)
    if(platform STREQUAL "ios")
      set(executable "${bundle}/studio_export")
      set(plist "${bundle}/Info.plist")
    else()
      set(executable "${bundle}/Contents/MacOS/studio_export")
      set(plist "${bundle}/Contents/Info.plist")
    endif()
    if(NOT EXISTS "${executable}" OR NOT EXISTS "${plist}")
      message(FATAL_ERROR "${platform} build did not produce the expected application: ${bundle}")
    endif()
    execute_process(COMMAND "${plutil}" -lint "${plist}" RESULT_VARIABLE result TIMEOUT 15)
    if(NOT result STREQUAL "0")
      message(FATAL_ERROR "${platform} Info.plist validation failed: ${result}")
    endif()
  endforeach()
endif()
