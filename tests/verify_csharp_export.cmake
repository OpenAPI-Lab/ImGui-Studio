file(MAKE_DIRECTORY "${WORK_ROOT}")
string(RANDOM LENGTH 12 ALPHABET "abcdefghijklmnopqrstuvwxyz0123456789" run)
set(root "${WORK_ROOT}/${run}")
file(MAKE_DIRECTORY "${root}")
file(WRITE "${root}/global.json" "{\"sdk\":{\"version\":\"8.0.100\",\"rollForward\":\"latestFeature\"}}\n")
set(ENV{DOTNET_CLI_HOME} "${WORK_ROOT}/cli")
set(ENV{NUGET_PACKAGES} "${WORK_ROOT}/packages")
set(ENV{NUGET_HTTP_CACHE_PATH} "${WORK_ROOT}/http-cache")
set(ENV{DOTNET_CLI_TELEMETRY_OPTOUT} "1")
set(ENV{DOTNET_NOLOGO} "1")

execute_process(COMMAND "${GENERATOR}" "${root}" RESULT_VARIABLE status TIMEOUT 30)
if(NOT status STREQUAL "0")
  message(FATAL_ERROR "Export generator failed: ${status}")
endif()
foreach(case IN ITEMS blank scene_inspector render_settings debug_console all_widgets edge empty window_chrome)
  execute_process(COMMAND "${DOTNET}" run --project "${root}/${case}/csharp/StudioExport.csproj"
    -p:TreatWarningsAsErrors=true -- --headless-test
    WORKING_DIRECTORY "${root}" TIMEOUT 55 RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors)
  if(NOT status STREQUAL "0" OR NOT output MATCHES "rendered three frames in memory")
    message(FATAL_ERROR "${case}: ${status}\n${output}\n${errors}")
  endif()
  if(case STREQUAL "edge" AND NOT output MATCHES "Model selection, templates, charts, animations and images verified")
    message(FATAL_ERROR "C# model, template, chart, animation and image interactions did not run:\n${output}")
  endif()
  if(case STREQUAL "window_chrome" AND NOT output MATCHES "Window chrome interactions verified")
    message(FATAL_ERROR "C# window chrome interactions did not run:\n${output}")
  endif()
endforeach()
message(STATUS "Eight generated C# projects compiled and rendered with ImGui.NET using the .NET 8 SDK")
if(TEST_WINDOW)
  foreach(case IN ITEMS all_widgets edge window_chrome)
    execute_process(COMMAND "${DOTNET}" run --no-build --project "${root}/${case}/csharp/StudioExport.csproj"
      -- --smoke-test
      WORKING_DIRECTORY "${root}" TIMEOUT 30 RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors)
    if(NOT status STREQUAL "0" OR NOT output MATCHES "rendered three OpenGL frames")
      message(FATAL_ERROR "${case} window: ${status}\n${output}\n${errors}")
    endif()
  endforeach()
  if(EXISTS "${root}/imgui.ini")
    message(FATAL_ERROR "Smoke test unexpectedly persisted ImGui window placement")
  endif()
  message(STATUS "Three generated C# projects rendered three GLFW/OpenGL frames each")
endif()
